{
  "name": "@apollosuny/react-truncate",
  "version": "0.3.1",
  "description": "Pixel-accurate multi-line text truncation for React 18/19 with an inline \"see more / see less\" toggle. Zero dependencies, accessible, Next.js App Router ready.",
  "keywords": [
    "react",
    "react-component",
    "truncate",
    "truncate-text",
    "text-truncate",
    "react-truncate",
    "ellipsis",
    "multiline-ellipsis",
    "line-clamp",
    "clamp",
    "text-overflow",
    "show more",
    "show-more-text",
    "see more",
    "read more",
    "expand-collapse",
    "emoji",
    "grapheme",
    "accessible",
    "a11y",
    "headless",
    "unstyled",
    "nextjs",
    "app-router",
    "react-19",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "apollosuny",
  "homepage": "https://react-truncate-alpha.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/apollosuny/react-truncate"
  },
  "bugs": {
    "url": "https://github.com/apollosuny/react-truncate/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "storybook": "^8.6.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
